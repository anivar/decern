target/
# keys and regenerable crypto artifacts — never commit
*.key
*.pub
*.bundle
*.ledger
# The ledger and Mission registry `decern-serve` writes in the working directory by
# default, so a walkthrough run from a checkout leaves nothing for `git status` to show.
/decern-ledger.jsonl
/decern-missions.json
# proptest failure corpus (local)
**/proptest-regressions/
# Bytecode from scripts/standards.py, which verify.sh runs and agents import. Regenerable,
# and one `git add -A` away from being committed.
__pycache__/
*.pyc

# Local working notes, drafts and captures. Same reasoning as the agent tooling below:
# a scratch directory inside the tree is one `git add -A` away from becoming repository
# content, and a reviewer should not have to tell a draft from a document.
scratchpad/

# Local agent tooling. Kept out of the tree deliberately: a contributor should not
# inherit hooks that shell out to a binary they did not install, and a reviewer
# auditing this repository should not have to reason about one.
.entire/
